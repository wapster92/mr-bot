# Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=your_token_here

# Bot mode: "long-polling" for local dev, "webhook" for production
BOT_MODE=long-polling

# Express server port (used only in webhook mode)
PORT=3000

# Public domain that Telegram can reach (required in webhook mode)
TELEGRAM_WEBHOOK_DOMAIN=https://mr-bot.1062685-cv77550.tmweb.ru

# URL path for Telegram webhook
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# Optional secret that Telegram includes in X-Telegram-Bot-Api-Secret-Token header
TELEGRAM_WEBHOOK_SECRET=

# Optional OpenVPN sidecar for corporate resources.
# Keep the actual .ovpn and auth.txt outside git in ./runtime/openvpn on the server.
OPENVPN_RUNTIME_DIR=./runtime/openvpn
OPENVPN_CONFIG_NAME=client.ovpn
OPENVPN_AUTH_NAME=auth.txt
# Keep Telegram/public internet on the server's normal route by default.
OPENVPN_IGNORE_REDIRECT_GATEWAY=true
# Extra raw flags for openvpn if the corporate profile requires them.
OPENVPN_EXTRA_ARGS=
OPENVPN_VERBOSITY=3
# Optional static host mappings when Docker does not pick up VPN DNS.
CORP_GITLAB_HOST=gitlab.almi-partner.ru
CORP_GITLAB_IP=172.20.3.1
CORP_JIRA_HOST=jira.almi-partner.ru
CORP_JIRA_IP=172.20.3.3

# GitLab webhook endpoint (POST from GitLab)
GITLAB_WEBHOOK_PATH=/gitlab/webhook

# Shared secret to validate X-Gitlab-Token header
GITLAB_WEBHOOK_TOKEN=supersecret

# GitLab API (for approvals/reviewers/author)
# Указывать корневой URL GitLab (без /api/v4)
GITLAB_API_BASE_URL=https://gitlab.example.com
GITLAB_API_TOKEN=your_token_here
# Ретраи API-запросов (макс. количество попыток)
GITLAB_API_RETRIES=3
# Базовая задержка между ретраями (мс), увеличивается экспоненциально
GITLAB_API_RETRY_BASE_MS=500
# Таймаут запроса к GitLab API (мс)
GITLAB_API_TIMEOUT_MS=10000
# Ограничить синк MR конкретными projectId (через запятую). Если не задано — используем projectId из БД.
# GITLAB_ALLOWED_PROJECT_IDS=112

# Persist входящие GitLab webhook payload'ы в logs/gitlab-events/ (true/false)
LOG_GITLAB_EVENTS=false
# Максимальный объём папки логов (MB), старые файлы будут удаляться
LOG_GITLAB_MAX_MB=20

# Сколько апрувов нужно по умолчанию, если GitLab не присылает approvals_left/required
APPROVALS_REQUIRED_DEFAULT=2

# MongoDB connection (локально через docker-compose)
MONGODB_URI=mongodb://mongo:27017/mr-bot
MONGODB_DB_NAME=mr-bot
MONGO_INITDB_ROOT_USERNAME=mrbot
MONGO_INITDB_ROOT_PASSWORD=change_me

# Mongo Express (web UI for MongoDB)
# UI доступен по https://<domain>/dbpanel/ (через nginx)

# Jira base URL (для генерации ссылок на задачи из веток MR)
JIRA_BASE_URL=https://jira.almi-partner.ru:8443/browse
